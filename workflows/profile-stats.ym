name: Update profile stats cards

on:
  workflow_dispatch:
  schedule:
    - cron: "0 6 * * *"
  push:
    paths:
      - "tools/make_stats_cards.py"
      - ".github/workflows/profile-stats.yml"
      - "README.md"

permissions:
  contents: write

jobs:
  update-profile-stats:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Generate stats SVGs
        env:
          PROFILE_USER: iamaffanyousuf
          STATS_TOKEN: ${{ secrets.STATS_TOKEN }}
          GITHUB_TOKEN: ${{ github.token }}
        run: python3 tools/make_stats_cards.py

      - name: Commit updated assets
        run: |
          if git diff --quiet; then
            echo "No stats changes to commit."
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add README.md assets/
          git commit -m "Update profile stats cards"
          git push
